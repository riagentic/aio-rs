#!/usr/bin/env python3
"""What developing on aio-rs costs, measured on a fresh template app (`ax
create`), recorded in scripts/dx-trend.csv, one row per run:

  crates           the app's shipped crates (slim-metrics' "app kit")
  clean_debug_s    first debug build, empty target folder (wall time)
  clean_debug_cpu  the same build's CPU seconds (all its processes)
  rebuild_s        one line of the app changed, debug rebuild (best of 3)
  rebuild_cpu      its CPU seconds
  release_s        `ax build --appimage --smoke`, empty release folder
  release_cpu      its CPU seconds
  binary_b         the release binary (bytes)
  targz_b          its .tar.gz bundle (bytes)
  appimage_b       its AppImage (bytes)
  boot_s           smoke: start to window ready
  window_mb        smoke: private memory of the app and its runtime, window up
                   (~40 MB less while another app runs on the same runtime)
  window_pss_mb    smoke: their PSS (shrinks while other apps share the runtime)
  window_dirty_mb  smoke: the private memory they wrote (gated: the same
                   whatever else runs)
  core_crates      aio-rs core's crates (slim-metrics' "aio-rs core")
  kit_crates       aio-rs with the kit ("aio-rs kit")
  debug_target_mb  the target folder after the clean debug build (disk)
  live_css_s       `ax dev`, headless: a stylesheet line saved → on the page
  live_rsx_s       an `rsx!` text saved → on the page
  live_logic_s     a line of Rust in the view saved → on the page (hot-patch)

  scripts/dx-metrics            measure, print, append the row
  scripts/dx-metrics --check    also fail on a regression past its limit
  scripts/dx-metrics --trend [n]  the last n rows (12) and today's limits
  scripts/dx-metrics --self-test  the gate's rules, on made-up rows

A limit comes from the rows before (`GATED`): crates no more than deps.toml's
ceiling; sizes and disk (stable to 0.01%) 5% over their rolling best, the best
of the last 10 rows; the window's memory written 15% over its rolling median
(its private memory drops ~40 MB while another app runs on the same runtime:
said, not gated); CPU seconds, boot and live-edit times (a shared
machine moved them 30% between two runs of one commit) 50% over their rolling
median. Each limit is at least an absolute slack over its mark, and times and
memory are judged against the same machine's rows only. Builds are judged by
CPU seconds: other work beside them stretches wall time more (kept for the
trend). A row names its machine only by a short hash (cpu model, cores,
memory, and Xvfb when the smoke draws on one). The template builds as `ax dev` builds it (cargo's defaults,
incremental, aio's debug profile, so `ax dev` reuses that build), in a
temporary folder removed afterwards.
"""
import csv
import datetime
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import re
import resource
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
TREND = ROOT / "scripts" / "dx-trend.csv"
COLUMNS = ["date", "commit", "machine", "crates", "clean_debug_s", "clean_debug_cpu", "rebuild_s", "rebuild_cpu",
           "release_s", "release_cpu", "binary_b", "targz_b", "appimage_b", "boot_s", "window_mb", "window_pss_mb",
           "core_crates", "kit_crates", "debug_target_mb", "live_css_s", "live_rsx_s", "live_logic_s", "window_dirty_mb"]
# Over the rolling best or median, by this much.
MEDIAN = lambda v: sorted(v)[len(v) // 2]  # noqa: E731
STEADY, MEMORY, NOISY = (min, 1.05), (MEDIAN, 1.15), (MEDIAN, 1.5)
REBUILD = "the template's build: `cargo build --timings` in an `ax create` app (target/cargo-timings)"
SIZES = "`ax build <app> --sizes` (bytes per crate)"
LIVE = "`ax dev <app>`: logs/dev.log (dx's lines, each patch's time)"
# Gated: (against what, the slack it must pass too, the same machine's rows only, how to see what grew).
GATED = {
    "crates": (STEADY, 0, False, "scripts/slim-metrics; why a crate: cargo tree -e normal -p aio-rs-shell -F aio/kit -i <crate>"),
    "core_crates": (STEADY, 0, False, "scripts/slim-metrics; cargo tree -e normal -p aio-rs --no-default-features -i <crate>"),
    "kit_crates": (STEADY, 0, False, "scripts/slim-metrics; cargo tree -e normal -p aio-rs --no-default-features -F kit -i <crate>"),
    "clean_debug_cpu": (NOISY, 5, True, REBUILD),
    "rebuild_cpu": (NOISY, 0.5, True, REBUILD),
    "release_cpu": (NOISY, 10, True, "`cargo build --release --timings` in an `ax create` app"),
    "debug_target_mb": (STEADY, 20, False, "du -sk <target>/*/desktop-dev/deps/* | sort -n | tail"),
    "binary_b": (STEADY, 50_000, False, SIZES),
    "targz_b": (STEADY, 50_000, False, SIZES + "; tar tvzf dist/<app>*.tar.gz"),
    "appimage_b": (STEADY, 50_000, False, SIZES + "; <app>.AppImage --appimage-extract"),
    "boot_s": (NOISY, 0.5, True, "`ax build <app> --smoke` (boot and memory lines)"),
    # Not window_mb: its runtime's file pages count as private only while no
    # other app runs on that runtime (82 against 126 MB, one build).
    "window_dirty_mb": (MEMORY, 5, True, "`ax build <app> --smoke` (boot and memory lines)"),
    "live_css_s": (NOISY, 0.25, True, LIVE),
    "live_rsx_s": (NOISY, 0.25, True, LIVE),
    "live_logic_s": (NOISY, 0.5, True, LIVE),
}
# A crate count is held to its deps.toml `[ceilings]` set too.
CEILING = {"crates": "app kit", "core_crates": "aio-rs core", "kit_crates": "aio-rs kit"}
WINDOW = 10
# `--trend`'s columns: the gated ones, short.
SHORT = {"crates": "app", "core_crates": "core", "kit_crates": "kit", "clean_debug_cpu": "clean", "rebuild_cpu": "rebuild",
         "release_cpu": "release", "debug_target_mb": "disk", "binary_b": "binary", "targz_b": "tar.gz",
         "appimage_b": "AppImage", "boot_s": "boot", "window_dirty_mb": "window", "live_css_s": "css", "live_rsx_s": "rsx",
         "live_logic_s": "logic"}
NAME = "dxapp"
# The live edits: (file, text before, after, the page once it shows). None: appended.
COUNT = "document.querySelector('[data-t=count]')"
EDITS = {
    "live_css_s": ("assets/style.css", None, "\nh1 { letter-spacing: 3px; }\n",
                   f"getComputedStyle({COUNT}).letterSpacing == '3px'"),
    "live_rsx_s": ("src/lib.rs", '"Add"', '"Add one"', "document.querySelector('button').textContent == 'Add one'"),
    "live_logic_s": ("src/lib.rs", 'h1 { "data-t": "count", "{n}" }', 'h1 { "data-t": "count", {(n.get() + 100).to_string()} }',
                     f"{COUNT}.textContent == '100'"),
}


def run(cmd, cwd, env):
    """`cmd`'s output, wall seconds and CPU seconds (it and its children)."""
    t, before = time.monotonic(), resource.getrusage(resource.RUSAGE_CHILDREN)
    out = subprocess.run(cmd, cwd=cwd, env=env, capture_output=True, text=True)
    if out.returncode:
        sys.exit(f"{' '.join(map(str, cmd))}:\n{out.stdout[-3000:]}{out.stderr[-3000:]}")
    after = resource.getrusage(resource.RUSAGE_CHILDREN)
    cpu = after.ru_utime + after.ru_stime - before.ru_utime - before.ru_stime
    return out.stdout + out.stderr, time.monotonic() - t, cpu


def machine():
    info = pathlib.Path("/proc/cpuinfo").read_text() if pathlib.Path("/proc/cpuinfo").exists() else ""
    model = next((l.split(":", 1)[1].strip() for l in info.splitlines() if l.startswith("model name")), "")
    mem = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") // 2**30
    # The smoke draws on Xvfb when there is one, else headless: 20% more window memory on Xvfb.
    display = "|xvfb" if shutil.which("Xvfb") else ""
    return hashlib.sha256(f"{model}|{os.cpu_count()}|{mem}{display}".encode()).hexdigest()[:8]


def commit():
    head = subprocess.run(["git", "rev-parse", "--short=8", "HEAD"], cwd=ROOT, capture_output=True, text=True)
    dirty = subprocess.run(["git", "status", "--porcelain"], cwd=ROOT, capture_output=True, text=True)
    return head.stdout.strip() + ("-dirty" if dirty.stdout.strip() else "")


def slim():
    loader = importlib.machinery.SourceFileLoader("slim", str(ROOT / "scripts/slim-metrics"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("slim", loader))
    loader.exec_module(mod)
    return mod


def crates():
    s = slim()
    sets = dict(s.SETS)
    return {col: len(s.crates(sets[name])) for col, name in CEILING.items()}


def host():
    out = subprocess.run(["rustc", "-vV"], capture_output=True, text=True).stdout
    return next(l.split(": ", 1)[1] for l in out.splitlines() if l.startswith("host: "))


def idle(pid):
    """Whether process `pid` used no CPU over the next 50 ms (Linux; elsewhere, yes)."""
    stat = pathlib.Path(f"/proc/{pid}/stat")
    cpu = lambda: sum(map(int, stat.read_text().rsplit(")", 1)[1].split()[11:13]))  # noqa: E731 utime, stime
    try:
        before = cpu()
        time.sleep(0.05)
        return cpu() == before
    except (OSError, ValueError):
        return True


def building(root):
    """Whether a build runs under process `root`: a cargo, rustc or linker
    among its descendants (Linux; elsewhere, no)."""
    procs = {}
    for stat in pathlib.Path("/proc").glob("[0-9]*/stat"):
        try:
            t = stat.read_text()
            procs[int(stat.parent.name)] = (t[t.index("(") + 1:t.rindex(")")], int(t.rsplit(")", 1)[1].split()[1]))
        except (OSError, ValueError):
            continue
    tree, more = {root}, True
    while more:
        kids = {p for p, (_, parent) in procs.items() if parent in tree} - tree
        tree, more = tree | kids, bool(kids)
    tools = ("cargo", "rustc", "cc", "ld", "ld.lld", "rust-lld", "mold")
    return any(procs[p][0] in tools for p in tree if p in procs)


def live(aio, app, env, home):
    """Each of `EDITS`, saved while `ax dev` runs the app headless: seconds
    from the save to the page showing it (polled in the page every 5 ms).
    None without dx's hot-patching (a rebuild and restart is not this)."""
    env = env | {"AIORT_ELECTRON_ARGS": f"--ozone-platform=headless {env.get('AIORT_ELECTRON_ARGS', '')}".strip()}
    # Outside the checkout: dx watches its tree, and each line written would
    # be a change for it to handle while an edit is timed.
    logs = tempfile.TemporaryDirectory(prefix="aio-dx-log-")
    log = pathlib.Path(logs.name) / "dev.out"
    with log.open("w") as out:
        dev = subprocess.Popen([aio, "dev", NAME, "--display", "current", "--home", home], cwd=app, env=env,
                               stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
    said = lambda: log.read_text(errors="replace")  # noqa: E731
    fail = lambda why: sys.exit(f"ax dev: {why}:\n{said()[-3000:]}")  # noqa: E731
    try:
        end = time.monotonic() + 300
        while "[aio] window ready" not in said():
            if dev.poll() is not None or time.monotonic() > end:
                fail("no window")
            if "rebuilding on change instead" in said():
                print("live edits: not measured (no dx with hot-patching)", file=sys.stderr)
                return {}
            time.sleep(0.2)
        evaluate = [aio, "eval", NAME, None, "--home", home]
        page = lambda js: subprocess.Popen(evaluate[:3] + [js] + evaluate[4:], cwd=app, env=env,  # noqa: E731
                                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        while page("1").communicate()[0].strip() != "1":
            if time.monotonic() > end:
                fail("its page doesn't answer")
            time.sleep(0.2)
        row = {}
        for col, (path, old, new, shows) in EDITS.items():
            f = app / path
            text = f.read_text()
            if old and old not in text:
                fail(f"the template has no {old} in {path} to edit")
            # The save waits until the page's poller runs: the poller says so
            # in the log (no other process to ask), so under load the `ax
            # eval` start is not timed as the edit and nothing starts during it.
            armed = f"[dx-metrics] armed {col}"
            js = (f"new Promise(r => {{ const t = setInterval(() => {{ try {{ if ({shows}) "
                  f"{{ clearInterval(t); r(Date.now()); }} }} catch (_) {{}} }}, 5); console.warn('{armed}'); }})")
            waiter = page(js)
            # …once the edit before is done with (`ax dev` said its burst, no
            # build of it runs: dx patches a stylesheet in too) and the waiter
            # has nothing left to do: their work would compete with the edit's.
            done = len(row)
            while (armed not in said() or said().count(" changed\n") < done or building(dev.pid)
                   or not idle(waiter.pid)):
                if waiter.poll() is not None or time.monotonic() > end:
                    fail("the page's poller didn't start")
                time.sleep(0.02)
            saved = time.time()
            f.write_text(text.replace(old, new, 1) if old else text + new)
            try:
                shown, _ = waiter.communicate(timeout=60)
                row[col] = json.loads(shown) / 1000 - saved
            except (subprocess.TimeoutExpired, ValueError):
                waiter.kill()
                fail(f"{path}: the edit didn't show in 60 s")
        return row
    finally:
        dev.terminate()
        dev.wait(timeout=30)
        logs.cleanup()


def du_mb(path):
    return int(subprocess.run(["du", "-sk", path], capture_output=True, text=True).stdout.split()[0]) // 1024


def measure(tmp):
    # aio-rs itself as ci.sh built it (its env); the template as a developer's.
    run(["cargo", "build", "-q", "--locked", "-p", "aio-rs-cli"], ROOT, os.environ)
    env = {k: v for k, v in os.environ.items() if k not in ("CARGO_INCREMENTAL", "DISPLAY", "WAYLAND_DISPLAY")}
    env["DBUS_SESSION_BUS_ADDRESS"] = "disabled:"
    aio = pathlib.Path(env.get("CARGO_TARGET_DIR") or ROOT / "target") / "debug" / "ax"
    env["CARGO_TARGET_DIR"] = str(tmp / "target")
    run([aio, "create", NAME, "--aio", ROOT], tmp, env)
    app = tmp / NAME
    shutil.copy(ROOT / "Cargo.lock", app / "Cargo.lock")
    # `ax dev`'s layout (its debug profile, the host target): its dx build reuses this one.
    build = ["cargo", "build", "--offline", "-p", f"{NAME}-app", "--profile", "desktop-dev", "--target", host()]
    row = crates()
    _, row["clean_debug_s"], row["clean_debug_cpu"] = run(build, app, env)
    row["debug_target_mb"] = du_mb(tmp / "target")
    lib = app / "src" / "lib.rs"
    text = lib.read_text()
    edits = []
    for n in range(3):
        lib.write_text(text.replace('"Add"', f'"Add {n}"', 1))
        edits.append(run(build, app, env)[1:])
    row["rebuild_s"], row["rebuild_cpu"] = min(edits)
    lib.write_text(text)
    sources = {p: (app / p).read_text() for p in {e[0] for e in EDITS.values()}}
    row |= live(aio, app, env, tmp / "home")
    for p, t in sources.items():
        (app / p).write_text(t)
    said, row["release_s"], row["release_cpu"] = run([aio, "build", NAME, "--appimage", "--smoke"], app, env)
    row["binary_b"] = (tmp / "target" / "release" / NAME).stat().st_size
    for col, end in (("targz_b", ".tar.gz"), ("appimage_b", ".AppImage")):
        row[col] = next(f.stat().st_size for f in (app / "dist").iterdir() if f.name.endswith(end))
    boot = re.search(r"window ready in ([\d.]+) s", said)
    mem = re.search(r"memory: (\d+) MB private, (\d+) MB PSS.*?, (\d+) MB written", said)
    row["boot_s"] = float(boot[1]) if boot else ""
    row["window_mb"], row["window_pss_mb"], row["window_dirty_mb"] = (int(mem[1]), int(mem[2]), int(mem[3])) if mem else ("", "", "")
    return {k: round(v, 3 if k.startswith("live_") else 1) if isinstance(v, float) else v for k, v in row.items()}


def history():
    if not TREND.exists():
        return []
    with TREND.open(newline="") as f:
        return list(csv.DictReader(f))


def save(row, rows):
    """`row` appended to the trend; the file rewritten first when its
    columns are older than `COLUMNS` (their rows keep blanks)."""
    header = TREND.read_text().partition("\n")[0].split(",") if TREND.exists() else []
    if header != COLUMNS:
        with TREND.open("w", newline="") as f:
            w = csv.DictWriter(f, COLUMNS, extrasaction="ignore")
            w.writeheader()
            w.writerows({k: v or "" for k, v in r.items() if k} for r in rows)
    with TREND.open("a", newline="") as f:
        csv.DictWriter(f, COLUMNS).writerow(row)


def num(v):
    """`v` as a row has it: whole from 1000 up, else to two decimals (pure)."""
    return f"{v:.0f}" if v >= 1000 else f"{v:.2f}".rstrip("0").rstrip(".")


def limits(machine_key, rows, ceilings):
    """Each gated metric's limit for a new row of `machine_key` (pure):
    (limit, how it is set, the commit of the row it comes from)."""
    out = {}
    for col, ((mark, margin), slack, same, _) in GATED.items():
        past = [r for r in rows if r.get(col) and (not same or r["machine"] == machine_key)][-WINDOW:]
        if past:
            was = mark([float(r[col]) for r in past])
            src = next(r["commit"] for r in reversed(past) if float(r[col]) == was)
            how = f"{'best' if mark is min else 'median'} {num(was)} of the last {len(past)} rows {margin - 1:+.0%}"
            out[col] = (max(was * margin, was + slack), how, src)
        cap = ceilings.get(CEILING.get(col))
        if cap is not None and (col not in out or cap < out[col][0]):
            out[col] = (cap, f"deps.toml [ceilings] \"{CEILING[col]}\"", out.get(col, (0, 0, None))[2])
    return out


def regressions(row, rows, ceilings=None):
    """Each gated metric of `row` past its limit, said with its limit and
    where to look (pure)."""
    out = []
    for col, (limit, how, src) in limits(row["machine"], rows, ceilings or {}).items():
        if row.get(col) in ("", None) or float(row[col]) <= limit:
            continue
        c = (src or "").removesuffix("-dirty")
        changes = f"git diff {c} -- Cargo.lock" if col in CEILING else f"git log --oneline {c}.."
        since = f"; since {c}: {changes}" if c else ""
        out.append(f"{col} {row[col]} is over its limit {num(limit)} ({how})\n"
                   f"    what grew: {GATED[col][3]}{since}; scripts/dx-metrics --trend")
    return out


def trend(n):
    """The last `n` rows, the gated columns, and this machine's next limits."""
    rows = history()
    cols = ["date", "commit"] + list(SHORT)
    shown = lambda c, v: f"{int(float(v)) // 1000}K" if v and c.endswith("_b") else (v or "-")  # noqa: E731
    table = [["date", "commit"] + list(SHORT.values())] + [[shown(c, r.get(c)) for c in cols] for r in rows[-n:]]
    caps = tomllib.loads((ROOT / "deps.toml").read_text())["ceilings"]
    lim = limits(machine(), rows, caps)
    table.append(["limit", ""] + [shown(c, num(lim[c][0])) if c in lim else ""
                                  for c in cols[2:]])
    width = [max(len(r[i]) for r in table) for i in range(len(cols))]
    for r in table:
        print("  ".join(v.rjust(w) for v, w in zip(r, width)).rstrip())
    print("builds in CPU seconds, live edits in seconds, sizes in KB, disk and window in MB; "
          "time and memory limits are this machine's")


def self_test():
    """The gate's rules, on made-up rows (`--self-test`, in ci.sh)."""
    base = {"machine": "m", "commit": "c0", "crates": "141", "core_crates": "49", "clean_debug_cpu": "100",
            "rebuild_cpu": "1.0", "release_cpu": "160", "binary_b": "5310528", "targz_b": "2745864",
            "appimage_b": "3533304", "boot_s": "0.2", "window_dirty_mb": "121", "debug_target_mb": "894",
            "live_logic_s": "0.4"}
    rows = [base | {"window_dirty_mb": w, "clean_debug_cpu": c, "commit": f"c{i}"}
            for i, (w, c) in enumerate([("121", "90"), ("94", "117"), ("122", "104")])]
    rows.append({"machine": "m", "commit": "old", "crates": "141"})  # an older row, without the newer columns
    first = lambda over, caps=None: (regressions(base | over, rows, caps) or [""])[0]  # noqa: E731
    assert first({}) == "", "the same numbers pass"
    assert first({"clean_debug_cpu": "140"}) == "", "build noise (+35% over the median) passes"
    said = first({"clean_debug_cpu": "170"})
    assert said.startswith("clean_debug_cpu 170 is over its limit 156 (median 104 of the last 3 rows +50%)"), said
    assert "since c2: git log --oneline c2.." in said and "--timings" in said, "it says where to look"
    assert first({"binary_b": "5600000"}).startswith("binary_b"), "+5.5% bytes fail"
    assert first({"binary_b": "5400000"}) == "", "+1.7% bytes pass"
    assert first({"debug_target_mb": "960"}).startswith("debug_target_mb"), "+7% disk fails"
    assert first({"window_dirty_mb": "138"}) == "", "+14% memory over the median passes (a low run is no best)"
    assert first({"window_dirty_mb": "150"}).startswith("window_dirty_mb"), "+24% memory fails"
    assert first({"window_mb": "300"}) == "", "private memory varies with what else runs: said, not gated"
    assert first({"live_logic_s": "0.8"}) == "", "+0.4 s on a hot-patch is within its slack"
    assert first({"live_logic_s": "1.2"}).startswith("live_logic_s"), "x3 a hot-patch fails"
    assert first({"machine": "other", "clean_debug_cpu": "900"}) == "", "another machine has no history yet"
    assert first({"crates": "142"}, {"app kit": 141}).startswith("crates 142 is over its limit 141"), "one crate more fails"
    said = first({"core_crates": "50"}, {"aio-rs core": 49})
    assert "deps.toml [ceilings] \"aio-rs core\"" in said, said
    assert first({"core_crates": "48"}, {"aio-rs core": 49}) == "", "fewer pass"
    print("dx-metrics: the gate's rules hold")


def main():
    args = sys.argv[1:]
    if "--self-test" in args:
        return self_test()
    if "--trend" in args:
        rest = args[args.index("--trend") + 1:]
        return trend(int(rest[0]) if rest and rest[0].isdigit() else 12)
    check = "--check" in args
    rows = history()
    # Beside the checkout (its target/): `ax create --aio` names the checkout
    # relative to the app, never through the root.
    (ROOT / "target").mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="aio-dx-", dir=ROOT / "target") as tmp:
        row = measure(pathlib.Path(tmp))
    row |= {"date": datetime.date.today().isoformat(), "commit": commit(), "machine": machine()}
    for col in COLUMNS:
        print(f"{col:16} {row.get(col, '')}")
    save(row, rows)
    caps = tomllib.loads((ROOT / "deps.toml").read_text())["ceilings"]
    bad = regressions(row, rows, caps)
    if bad:
        print("dx-metrics: past the limit (scripts/dx-trend.csv has the row):\n  " + "\n  ".join(bad), file=sys.stderr)
        if check:
            sys.exit(1)


if __name__ == "__main__":
    main()
