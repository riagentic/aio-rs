{
  "name": "aio-rs-client",
  "version": "0.4.1",
  "description": "aio-rs's client for any view library: an aio-rs app's cells, patches, calls and offline queue, with React, Solid and Vue bindings",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./solid": {
      "types": "./solid.d.ts",
      "default": "./solid.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "react.js",
    "react.d.ts",
    "solid.js",
    "solid.d.ts",
    "vue.js",
    "vue.d.ts"
  ],
  "peerDependencies": {
    "react": ">=18",
    "solid-js": ">=1.6",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/ && tsc -p test"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "esbuild": "0.25.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "solid-js": "1.9.9",
    "svelte": "5.57.3",
    "typescript": "5.9.3",
    "vue": "3.5.45"
  }
}
