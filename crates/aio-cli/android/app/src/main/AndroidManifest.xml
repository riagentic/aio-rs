<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Sync and updates; the page itself has no network. -->
  <uses-permission android:name="android.permission.INTERNET" />{{CAMERA}}
  <application
    android:allowBackup="false"
    android:usesCleartextTraffic="false"
    android:label="{{NAME}}"
    android:icon="@drawable/ic_launcher"
    android:theme="{{THEME}}"
  >
    <!-- configChanges: a rotation, keyboard or font change must not recreate
         the activity (that reloads the page); the WebView resizes itself. -->
    <activity
      android:name="aio.rt.MainActivity"
      android:exported="true"{{LAUNCH_MODE}}
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|fontScale|density"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>{{LINKS}}
    </activity>
  </application>
</manifest>
